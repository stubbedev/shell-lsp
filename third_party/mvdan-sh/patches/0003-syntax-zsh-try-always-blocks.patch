+func (p *Printer) braceGroup(b *Block) {
+	p.w.WriteByte('{')
+	// avoid ; in an empty block
+	p.wroteSemi = true
+	p.wantSpace = spaceRequired
+	// Forbid "foo()\n{ bar; }"
+	p.wantNewline = p.wantNewline || p.funcNextLine
+	p.nestedStmts(b.Stmts, b.Last, b.Rbrace)
+	p.semiRsrv("}", b.Rbrace)
+}
