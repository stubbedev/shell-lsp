+// comment lexes a comment from its '#', the current rune, to the end of the
+// line, and then the token after it.
+func (p *Parser) comment() {
+	r := p.rune()
+	p.newLit(r)
+runeLoop:
+	for {
+		switch r {
+		case '\n', runeEOF:
+			break runeLoop
+		case escNewl:
+			p.litBs = append(p.litBs, '\\', '\n')
+			break runeLoop
+		case '`':
+			if p.backquoteEnd() {
+				break runeLoop
+			}
+		}
+		r = p.rune()
+	}
+	if p.keepComments {
+		*p.curComs = append(*p.curComs, Comment{
+			Hash: p.pos,
+			Text: p.endLit(),
+		})
+	} else {
+		p.litBs = nil
+	}
+	p.next()
+}
