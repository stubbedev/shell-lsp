+// subFlagsBracket tracks the brackets in a [paramExpSubFlagsArg] word, such as
+// the bracket expression in ${a[(r)[ab]*]}, and reports whether r still
+// belongs to the word.
+func (p *Parser) subFlagsBracket(r rune) bool {
+	switch {
+	case r == '[':
+		p.subFlagsBrackets++
+	case p.subFlagsBrackets == 0:
+		return false
+	default:
+		p.subFlagsBrackets--
+	}
+	return true
+}
