-func (c *IfClause) End() Pos { return posAddCol(c.FiPos, 2) }
+func (c *IfClause) End() Pos {
+	last := c
+	for last.Else != nil {
+		last = last.Else
+	}
+	switch {
+	case last.Braces:
+		return posAddCol(last.Rbrace, len("}"))
+	case last.Short:
+		return stmtLastEnd(last.Then)
+	}
+	return posAddCol(c.FiPos, len("fi"))
+}
 
