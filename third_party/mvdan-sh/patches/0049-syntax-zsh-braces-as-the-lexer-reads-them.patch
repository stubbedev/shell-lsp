+
+func (p *Parser) push(next lexed) {
+	p.pushed = lexed{tok: p.tok, val: p.val, pos: p.pos, spaced: p.spaced, eqlOffs: p.eqlOffs}
+	p.hasPushed = true
+	p.tok, p.val, p.pos, p.spaced, p.eqlOffs = next.tok, next.val, next.pos, next.spaced, next.eqlOffs
