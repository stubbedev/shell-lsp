syntax: a here-document delimiter with any quoted part keeps its body literal

unquotedWordBytes reported whether the delimiter word was quoted by the
last of its parts alone, so a delimiter quoted only in part, such as
'E'OF or '`'a, read its body as an unquoted here-document: $bar and
`x` in the body were parsed as expansions, and a body line holding a
backquote, like the closing line `a, opened a command substitution that
never ended:

	cat <<'`'a
	`a

failed with "reached EOF without closing quote" although bash -n, dash
-n and zsh -n accept it. As in the shells, quoting any part of the word
now makes the body literal. FuzzParse in shell-lsp found it through the
input <<'`'0&.

diff --git a/syntax/filetests_test.go b/syntax/filetests_test.go
index 9b35b04..ec061e3 100644
--- a/syntax/filetests_test.go
+++ b/syntax/filetests_test.go
@@ -2276,6 +2276,27 @@ var fileTests = []fileTestCase{
 			}},
 		})),
 	),
+	fileTest(
+		[]string{"foo <<'E'OF\n$bar `x`\nEOF"},
+		langFile(&Stmt{
+			Cmd: litCall("foo"),
+			Redirs: []*Redirect{{
+				Op:   Hdoc,
+				Word: word(sglQuoted("E"), lit("OF")),
+				Hdoc: litWord("$bar `x`\n"),
+			}},
+		}),
+	),
+	fileTest(
+		[]string{"foo <<'`'a\n`a"},
+		langFile(&Stmt{
+			Cmd: litCall("foo"),
+			Redirs: []*Redirect{{
+				Op:   Hdoc,
+				Word: word(sglQuoted("`"), lit("a")),
+			}},
+		}),
+	),
 	fileTest(
 		[]string{"foo <<'EOF'\nbar\nEOF`oops`\nEOF"},
 		langFile(&Stmt{
diff --git a/syntax/parser.go b/syntax/parser.go
index 6bf029f..bb1a575 100644
--- a/syntax/parser.go
+++ b/syntax/parser.go
@@ -810,7 +810,11 @@ func (p *Parser) unquotedWordBytes(w *Word) ([]byte, bool) {
 	buf := make([]byte, 0, 4)
 	didUnquote := false
 	for _, wp := range w.Parts {
-		buf, didUnquote = p.unquotedWordPart(buf, wp, false)
+		var quoted bool
+		buf, quoted = p.unquotedWordPart(buf, wp, false)
+		// Quoting any part of the word, not just the last one, makes
+		// the here-document body literal.
+		didUnquote = didUnquote || quoted
 	}
 	return buf, didUnquote
 }
