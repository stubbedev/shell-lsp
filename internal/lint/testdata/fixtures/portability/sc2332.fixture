### option test without negation is fine
#!/bin/bash
if [ -o noclobber ]; then
  echo "noclobber on"
fi
>>> none

### negated option test in double brackets is fine
#!/bin/bash
if [[ ! -o noclobber ]]; then
  echo "clobbering allowed"
fi
>>> none

### negating the whole test command is fine
#!/bin/bash
if ! [ -o noclobber ]; then
  echo "clobbering allowed"
fi
>>> none
