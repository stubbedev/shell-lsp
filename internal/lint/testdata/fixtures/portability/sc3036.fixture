### no-newline plus escapes cluster in dash
#!/bin/dash
echo -ne "loading"
>>> SC3036 2:6

### uppercase E flag in dash
#!/bin/dash
echo -E "raw\n"
>>> SC3036 2:6

### repeated n cluster in dash
#!/bin/dash
echo -nn "prompt"
>>> SC3036 2:6

### uppercase E flag in busybox
