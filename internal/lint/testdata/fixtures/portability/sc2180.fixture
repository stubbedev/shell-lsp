### two indices in plain assignment
#!/bin/bash
grid[1][2]=wall
echo "${grid[@]}"
>>> SC2180 2:9

### two keys in compound array element
#!/bin/bash
board=([0][0]=rook [0][1]=knight)
echo "${board[@]}"
>>> SC2180 2:12
>>> SC2180 2:24

### two subscripts in expansion
#!/bin/bash
grid[3]=floor
echo "${grid[1][2]}"
>>> SC2180 3:7

### single index assignment is fine
#!/bin/bash
grid[1]=wall
echo "${grid[@]}"
>>> none

### single key in compound array element is fine
#!/bin/bash
board=([0]=rook [1]=knight)
echo "${board[@]}"
>>> none

### single subscript in expansion is fine
#!/bin/bash
grid[1]=wall
echo "${grid[1]}"
>>> none

### further subscripts in declarations, lengths and defaults
#!/bin/bash
declare cell[1][2]=x
f() { local c[1][2]=x; echo "${c[@]}"; }
echo "${#cell[1][2]}" "${cell[1][2]:-d}" "${cell[1]}[2]"
f
>>> SC2180 2:17
>>> SC2180 3:18
>>> SC2180 4:24
>>> SC2180 4:7

### three subscripts are reported once
#!/bin/bash
cube[1][2][3]=x
echo "${cube[1][2][3]}"
deep=([1][2][3]=x)
echo "${deep[@]}"
>>> SC2180 2:9
>>> SC2180 3:7
>>> SC2180 4:11

### spaced and expanded second subscript
#!/bin/bash
i=1
grid[ 1 ][ $i ]=y
echo "${grid[@]}" "${grid[$i][$i]}"
>>> SC2004 3:12
>>> SC2180 3:12
>>> SC2180 4:20

### ksh93 has multidimensional arrays
#!/bin/ksh
grid[1][2]=wall
echo "${grid[1][2]}"
>>> none

### sh leaves arrays to the portability checks
#!/bin/sh
grid=([1][2]=wall)
echo "${grid[1][2]}"
>>> SC3030 2:6
>>> SC3054 3:7
