### read uses -u with its own descriptor
while read -r -u 3 host; do
  ssh "$host" uptime
done 3< hosts.txt
>>> none

### loop condition is not a read
while true; do
  ssh backup.example.org rsync-status
  sleep 60
done
>>> none

### ssh stdin from /dev/null
while read -r host; do
  ssh "$host" uptime < /dev/null
done < hosts.txt
>>> none

### ssh receives piped input
while read -r host; do
  echo "uptime" | ssh "$host" bash
done < hosts.txt
>>> none

### read takes stdin from a duplicated descriptor
exec 4< hosts.txt
while read -r host <&4; do
  ssh "$host" uptime
done
>>> none

