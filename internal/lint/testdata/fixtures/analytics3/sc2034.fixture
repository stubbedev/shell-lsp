### variables read by name through namerefs, declare -p and indirection
#!/bin/bash
dump() {
	local verbose=false
	if [[ $1 == -v ]]; then
		verbose=true
		shift
	fi
	local name=$1
	local -n ref=$name
	$verbose && declare -p -- "$name"
	echo "$ref"
}
first=1
second=2
unused=3
names=(first second)
for var in "${names[@]}"; do
	dump -v "$var"
done
declare -n alias_of=third
third=4
echo "$alias_of"
pre_one=5
echo "${!pre_@}"
>>> SC2034 15:1
