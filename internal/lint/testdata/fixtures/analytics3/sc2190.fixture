### associative array literal with a plain element
declare -A mime
mime=(text/html)
echo "${mime[@]}"
>>> SC2190 2:7
>>+ SL2024 2:7 -- bash 5.1 reads the lone element as a key and gives it an empty value; shellcheck does not count the elements of a key value list

### typeset -A then append a plain element
typeset -A owners
owners+=(alice)
echo "${owners[@]}"
>>> SC2190 2:10
>>+ SL2024 2:10 -- bash 5.1 reads the lone element as a key and gives it an empty value; shellcheck does not count the elements of a key value list

### associative array literal with name=value element
declare -A limits
limits=(cpu=2 memory=512)
echo "${limits[@]}"
>>> SC2190 2:15
>>> SC2190 2:9

### indexed array declared with -a
declare -a queue
queue=(first second)
echo "${queue[@]}"
>>> none

### associative array with bracketed keys
declare -A limits
limits=([cpu]=2 [memory]=512)
echo "${limits[@]}"
>>> none

### a bare element after a bracketed key is rejected in every bash
declare -A limits
limits=([cpu]=2 memory)
echo "${limits[@]}"
>>> SC2190 2:17

### zsh reads a list without bracketed keys as key value pairs
#!/bin/zsh
typeset -A limits
limits=(cpu 2 memory 512)
print -r -- ${(kv)limits}
>>- SC1071 1:1 -- shellcheck refuses zsh

### zsh rejects a bare element after a bracketed key
#!/bin/zsh
typeset -A limits
limits=([cpu]=2 memory 512)
print -r -- ${(kv)limits}
>>- SC1071 1:1 -- shellcheck refuses zsh
>>+ SC2190 3:17 -- zsh rejects a bare element once the first one has a bracketed key
>>+ SC2190 3:24 -- zsh rejects a bare element once the first one has a bracketed key
