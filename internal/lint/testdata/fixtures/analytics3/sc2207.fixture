### compgen of names and fixed words
_complete() {
	local cur=${COMP_WORDS[COMP_CWORD]}
	COMPREPLY=(
		$(compgen -v -- "$cur")
		$(compgen -W '-a -e -v -h' -- "$cur")
		$(compgen -A user -u "$cur")
	)
	COMPREPLY=($(compgen -W "$commands" -- "$cur"))
	COMPREPLY=($(compgen -f -- "$cur"))
	COMPREPLY=($(compgen -W '*.txt' -- "$cur"))
	COMPREPLY=($(compgen -o default -v -- "$cur"))
}
complete -F _complete tool
echo $(compgen -v)
