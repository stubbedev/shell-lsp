### echo with -e flag is fine
banner="$(echo -e "\tWelcome")"
printf '%s\n' "$banner"
>>> none

### plain echo without substitution is fine
echo $PATH
>>> SC2086 1:6

### echo with a glob argument is fine
listing=$(echo files: *.png)
printf '%s\n' "$listing"
>>> none

### echo of a single command substitution is left to SC2005
kernel=$(echo "$(uname -r)")
printf '%s\n' "$kernel"
