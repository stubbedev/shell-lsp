### trailing assignment printf and return are cleanup
launch() {
  exec ./daemon
  rc=$?
  printf 'launch failed\n' >&2
  return "$rc"
}
launch
>>> none

### trailing colon is cleanup
exec ./daemon
:
>>> none

### execfail in bash disables the check
#!/bin/bash
shopt -s execfail
exec primary-worker
exec backup-worker
echo "both failed"
exit 1
>>> none

### exec inside a subshell is not examined
( exec ./daemon; echo after )
