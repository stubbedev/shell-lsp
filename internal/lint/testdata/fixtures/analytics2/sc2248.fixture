### bats status in unquoted numeric test
#!/usr/bin/env bats
@test "succeeds" {
  run ./build.sh
  [ $status -eq 0 ]
}
>>> none

### plain word echoed unquoted
region=eu-west-1
echo $region
>>> none

### plain word echoed inside quotes
region=eu-west-1
echo "$region"
>>> none

### dirty value fires SC2086 instead
region=$(curl -s http://metadata/region)
echo $region
>>> SC2086 2:6

### a default assigned only when the caller left it empty
[ -z "$VERSION" ] && VERSION=1.2
echo $VERSION
>>> SC2086 2:6

### a word assigned on one branch only
if [ -n "$1" ]; then mode=fast; fi
echo $mode
>>> SC2086 2:6

### a word assigned on every branch
if [ -n "$1" ]; then mode=fast; else mode=slow; fi
echo $mode
>>> none
