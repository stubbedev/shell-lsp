### positional ten inside double quotes
echo "argument ten is $10"
>>> SC1037 1:23

### file-wide directive drops the parser warning
# shellcheck disable=SC1037
echo "argument ten is $10"
>>> none

### plain comment between directive and command
# shellcheck disable=SC1037
# only nine arguments are ever passed
echo "argument ten is $10"
>>> none

### command-scoped directive drops the parser warning for its command only
:
# shellcheck disable=SC1037
echo "tenth: $10"
echo "eleventh: $11"
>>> SC1037 4:17

### parse failure codes suppressed by a directive
# shellcheck disable=SC1073,SC1072,SC2148
()
>>> none

### parse failure codes without a directive
()
>>> SC1072 1:3
>>> SC1073 1:1

### parse failure inside a construct suppressed by an enclosing command directive
:
# shellcheck disable=SC1009,SC1072,SC1073,SC1046,SC1047
if [ -f /etc/motd ]; then
  cat /etc/motd
>>> none

### indented end token in a here document
cat <<BANNER
  BANNER
welcome (again)
BANNER
>>> SC1039 2:1

### directive before a here document with an indented end token
# shellcheck disable=SC1039
cat <<BANNER
  BANNER
welcome (again)
BANNER
>>> none

### here-document body checked with the scope of its operator
:
# shellcheck disable=SC1037
cat <<REPORT
first: $1
tenth: $10
REPORT
>>> none

### here-document body warning outside the directive scope
:
# shellcheck disable=SC1037
echo start
cat <<REPORT
tenth: $10
REPORT
>>> SC1037 5:8

### shebang diagnostic is not suppressed by a file-wide directive
!#/bin/sh
# shellcheck disable=SC1084
echo "$1"
>>> SC1084 1:1

### misplaced shebang is not suppressed by a file-wide directive

#!/bin/sh
# shellcheck disable=SC1128
echo "$1"
>>- SC1128 2:1 -- this linter honours a file-wide disable for every finding, including the shebang checks shellcheck runs before reading directives

### byte order mark suppressed by a file-wide directive
﻿#!/bin/sh
# shellcheck disable=SC1082
echo "$1"
>>> none

### byte order mark without a directive
﻿#!/bin/sh
echo "$1"
>>> SC1082 1:1

### unsupported shell suppressed by a file-wide directive
#!/usr/bin/zsh
# shellcheck disable=SC1071
for f (*.txt) print $f
>>> none

### unrecognised interpreter suppressed by a file-wide directive
#!/opt/tools/bin/runner
# shellcheck disable=SC1008
login_shell=/bin/sh
echo "$login_shell"
>>> none

### unrecognised interpreter without a directive
#!/opt/tools/bin/runner
login_shell=/bin/sh
echo "$login_shell"
>>> SC1008 1:1

### baseline analysis finding
echo $1
>>> SC2086 1:6

### directive drops the analysis finding
# shellcheck disable=SC2086
echo $1
>>> none

### directive and a comment before the command
# shellcheck disable=SC2086
# callers pass a single word
echo $1
>>> none

### missing shebang reported on the script itself
preferred_shell=/bin/sh
echo "$preferred_shell"
>>> SC2148 1:1

### file-wide directive drops the missing-shebang finding
# shellcheck disable=SC2148
preferred_shell=/bin/sh
echo "$preferred_shell"
>>> none

### directive on a function covers findings nested in its body
#!/bin/sh
:
# shellcheck disable=SC2086
cleanup() {
  if [ -d "$1" ]; then
    rm -rf $1/cache
  fi
}
cleanup "$1"
>>> none
