### backslash-escaped parentheses in double brackets
if [[ \( $1 = start \) ]]; then
  echo starting
fi
>>- SC1029 1:21 -- bash rejects escaped or quoted parentheses inside [[ ]], so this is a parser syntax error whose message says to use plain ( )
>>- SC1029 1:7 -- bash rejects escaped or quoted parentheses inside [[ ]], so this is a parser syntax error whose message says to use plain ( )

### quoted parentheses in double brackets
if [[ '(' $1 = stop ')' ]]; then
  echo stopping
fi
>>- SC1029 1:21 -- bash rejects escaped or quoted parentheses inside [[ ]], so this is a parser syntax error whose message says to use plain ( )
