### esac as an alternative in a case pattern
action=$1
case $action in
  halt|esac) echo stopping ;;
esac
>>> SC1010 3:8

### other closing keywords in a case pattern are not checked
action=$1
case $action in
  then|done|fi) echo odd ;;
esac
>>> none

### quoted keyword is fine
echo "done" 'fi'
>>> none

### keyword with extra characters is fine
echo done2 fiddle thenceforth
>>> none

### keyword with different case is fine
echo Done FI
>>> none
