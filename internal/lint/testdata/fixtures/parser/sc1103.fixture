### unknown shell name in a directive
# shellcheck shell=zsh
echo $1
>>- SC1103 1:20 -- zsh is a dialect this linter supports, so shell=zsh is a known shell
>>- SC2086 2:6 -- zsh is linted natively, and zsh does not split unquoted parameters; shellcheck falls back to bash

### absolute interpreter path in a directive
# shellcheck shell=/bin/bash
echo $1
>>> SC1103 1:20
>>> SC2086 2:6

### unknown shell still suppresses shebang validation
#!/opt/tools/runner
# shellcheck shell=fish
echo "$1"
>>> SC1103 2:20

### known shell names
# shellcheck shell=ksh93
print -r -- "$1"
>>> none

### busybox shell name
# shellcheck shell=busybox
echo "$1"
>>> none
