### longer chains are reported once per or
#!/bin/bash
# shellcheck enable=require-test-grouping
[[ -n $1 || -n $2 || -f $3 && -r $3 ]] && echo ok
[[ -n $1 && -n $2 && -n $3 || -z $4 ]] && echo ok
>>+ SL2012 3:19 -- shell-lsp native check; shellcheck does not report unparenthesised && inside ||
>>+ SL2012 4:28 -- shell-lsp native check; shellcheck does not report unparenthesised && inside ||

### mix inside parentheses
#!/bin/bash
# shellcheck enable=require-test-grouping
[[ ! ( -n $1 && -n $2 || -n $3 ) ]] && echo ok
>>+ SL2012 3:23 -- shell-lsp native check; shellcheck does not report unparenthesised && inside ||

### parenthesised groups are fine
#!/bin/bash
# shellcheck enable=require-test-grouping
[[ ( -f $1 && -r $1 ) || -n $2 ]] && echo ok
[[ -n $1 || ( -f $2 && -r $2 ) ]] && echo ok
>>> none

### one kind of operator is fine
#!/bin/bash
# shellcheck enable=require-test-grouping
[[ -n $1 && -n $2 && -n $3 ]] && echo ok
[[ -n $1 || -n $2 || -n $3 ]] && echo ok
>>> none

### command lists and single brackets are not test expressions
#!/bin/bash
# shellcheck enable=require-test-grouping
[ -n "$1" ] && [ -n "$2" ] || echo missing
[[ -n $1 ]] && [[ -n $2 ]] || echo missing
>>> none

