### symbolic modes that grant others write
#!/bin/sh
chmod o+w /etc/sudoers
chmod a+rwX /etc/sudoers.d
chmod u=rwx,g=rx,o=rwx /usr/local/bin/tool
chmod go+w ~/.bashrc
chmod a=rw ~/.gnupg/pubring.kbx
