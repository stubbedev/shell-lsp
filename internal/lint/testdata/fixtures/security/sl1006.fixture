### modes that keep others out are fine
#!/bin/sh
chmod 755 /usr/local/bin/tool
chmod 600 ~/.ssh/id_rsa
chmod 644 ~/.ssh/id_rsa.pub
chmod o-w /etc/passwd
chmod o+w,o-w /etc/passwd
chmod +w ~/.bashrc
chmod u+w,g+w ~/.bashrc
chmod g=rwx /usr/local/share/app
mkdir -m 700 ~/.ssh
install -m 755 tool /usr/local/bin/tool
>>> none

### world-writable paths that are not sensitive are left alone
#!/bin/sh
chmod 777 /tmp/build
chmod -R 777 /var/www/html
chmod 666 ./output.log
chmod 777 "$dir"
chmod 1777 /tmp
mkdir -m 777 /srv/share
>>> SC2154 5:12

### modes that cannot be read are left alone
#!/bin/sh
mode=777
chmod "$mode" ~/.ssh
chmod --reference=/tmp ~/.ssh
install -m "$mode" key ~/.ssh/authorized_keys
>>> none

