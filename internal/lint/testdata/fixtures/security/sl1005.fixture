### downloads saved to a file or read as data are not run
#!/bin/bash
curl -fsSLo install.sh https://example.com/install.sh
curl -fsSLO https://example.com/i.sh | sh
curl --output out https://example.com/i.sh | sh
wget https://example.com/i.sh | bash
curl -s https://example.com/data.json | jq .
curl -s https://example.com/x | bash script.sh
>>> none
