### a download run through -c, process substitution, source and eval
#!/bin/bash
sh -c "$(curl -fsSL https://example.com/install.sh)"
bash -o pipefail -c "$(wget -O - https://example.com/x)"
bash <(curl -s https://example.com/i.sh)
source <(curl -s https://example.com/env.sh)
curl -fsSL https://example.com/i.sh | . /dev/stdin
eval "$(curl -s https://example.com/env)"
