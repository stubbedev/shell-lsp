### an extended glob in arguments without shopt is a syntax error
#!/bin/bash
rm -- @(a|b).log
>>+ SL2016 2:7 -- shell-lsp native check; shellcheck does not track the glob options a pattern needs

### an extended glob after shopt at the top is fine
#!/bin/bash
shopt -s extglob
rm -- @(a|b).log
>>> none

### shopt in the same function comes too late
#!/bin/bash
clean() {
  shopt -s extglob
  rm -- !(keep).log
}
clean
>>+ SL2016 4:9 -- shell-lsp native check; shellcheck does not track the glob options a pattern needs

