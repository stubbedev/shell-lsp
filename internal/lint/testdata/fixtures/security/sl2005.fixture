### exit inside a command substitution or pipeline stage nobody checks
#!/bin/bash
dir=$(cd "$1" || exit 1; pwd)
echo "$dir"
echo "$(cat "$2" || exit 1)"
seq 3 | while read -r n; do [ "$n" = 2 ] && exit 1; done
echo after
