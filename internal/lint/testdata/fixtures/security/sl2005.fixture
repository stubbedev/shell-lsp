### the status is checked, so the exit reaches the script
#!/bin/bash
seq 3 | while read -r n; do exit 2; done || exit $?
seq 3 | while read -r n; do exit 3; done
echo "status $?"
x=$(false || exit 4) || exit 1
if y=$(false || exit 5); then echo "$x $y"; fi
( exit 6 )
seq 3 | while read -r n; do exit 7; done
