# shellcheck enable=check-relative-sources
. /etc/os-release
. ~/.config/app.sh
. "$HOME/.config/app.sh"
. "$1"
. "${srcdir:-.}/common.sh"
. "${LIBDIR-lib}/common.sh"
. @out@/nix-support/setup-hook.sh
