### paths anchored to the script are fine
#!/bin/bash
# shellcheck enable=check-relative-sources
here=$(cd "$(dirname "$0")" && pwd)
. "$here/lib.sh"
. "$(dirname "$0")/lib.sh"
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
source "${BASH_SOURCE%/*}/lib.sh"
dir=${0%/*}
. "$dir/lib.sh"
