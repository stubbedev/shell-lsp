### locals and shell variables are not globals
#!/bin/bash
# shellcheck enable=google-comment-sections

# Split the path.
split() {
  local item parts
  IFS=: read -ra parts <<< "$PATH"
  for item in "${parts[@]}"; do :; done
}
split
