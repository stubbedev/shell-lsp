### a complete header comment
#!/bin/bash
# shellcheck enable=google-comment-sections
BACKUP_DIR=/var/backup

#######################################
# Copy a file into the backup directory.
# Globals:
#   BACKUP_DIR
# Arguments:
#   File to copy.
# Outputs:
#   Writes the copy's path to stdout.
# Returns:
#   1 if the copy failed.
#######################################
backup() {
  cp "$1" "$BACKUP_DIR" || return 1
  echo "$BACKUP_DIR/$1"
}
backup x
>>> none

