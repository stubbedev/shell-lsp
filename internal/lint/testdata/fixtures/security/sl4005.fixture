### arguments through shift and getopts, globals written
#!/bin/bash
# shellcheck enable=google-comment-sections
verbose=0

# Parse the options.
parse() {
  while getopts v opt; do
    verbose=1
  done
  shift "$((OPTIND - 1))"
}
parse "$@"
echo "$verbose $opt"
