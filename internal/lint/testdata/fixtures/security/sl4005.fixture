### nested functions count for themselves
#!/bin/bash
# shellcheck enable=google-comment-sections

# Define the helper.
outer() {
  # Print the first argument.
  # Arguments:
  #   A word.
  # Outputs:
  #   The word.
  inner() { echo "$1"; }
  inner hi
}
outer
