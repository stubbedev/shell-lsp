### output that goes elsewhere is not output
#!/bin/bash
# shellcheck enable=google-comment-sections

# Record the time.
stamp() {
  local now
  now=$(date)
  printf -v now '%s' "$now"
  echo "$now" > /tmp/stamp
  echo "$now" >> /tmp/log
  return
}
stamp
>>> none

### stderr is output
#!/bin/bash
# shellcheck enable=google-comment-sections

# Complain.
complain() {
  local message=finished
  echo "$message" >&2
  printf '%s\n' "$message" > /dev/stderr
}
complain
