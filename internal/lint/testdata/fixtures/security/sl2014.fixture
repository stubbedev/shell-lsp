### ksh needs the function keyword for typeset to be local
#!/bin/ksh
# shellcheck enable=require-local-variables
function keyword {
  name=$1
  echo "$name"
}
posix() {
  other=$1
  echo "$other"
}
keyword x
posix y
>>+ SL2014 4:3 -- shell-lsp native check; shellcheck does not ask for local

