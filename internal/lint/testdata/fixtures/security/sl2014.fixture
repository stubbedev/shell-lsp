### shell variables are fine
#!/bin/bash
# shellcheck enable=require-local-variables
complete_it() {
  COMPREPLY=(a b)
  IFS=,
  OPTIND=1
  REPLY=x
}
complete -F complete_it cmd
>>> none

### top-level code is not checked
#!/bin/bash
# shellcheck enable=require-local-variables
x=1
for y in a; do echo "$x $y"; done
>>> SC2043 4:10

### sh has no local
#!/bin/sh
# shellcheck enable=require-local-variables
work() {
  name=$1
  echo "$name"
}
work x
>>> none

### dash has local
#!/bin/dash
# shellcheck enable=require-local-variables
work() {
  name=$1
