### functions writing variables the top level never sets are left to SL2014
#!/bin/bash
# shellcheck enable=avoid-global-reassignment
work() {
  result=1
  result=2
}
work
echo "$result"
>>> none

### shell variables are fine
#!/bin/bash
# shellcheck enable=avoid-global-reassignment
IFS=,
IFS=' '
PATH=/bin
add_path() { PATH=$PATH:/usr/local/bin; }
add_path
>>> none

### setup before readonly follows the style guide
#!/bin/bash
# shellcheck enable=avoid-global-reassignment
VERBOSE=false
while getopts v flag; do
  case $flag in
    v) VERBOSE=true ;;
  esac
done
readonly VERBOSE
MODE=a
set_mode() { MODE=$1; }
set_mode b
readonly MODE
echo "$VERBOSE $MODE"
>>> SC2220 5:3

### off unless enabled
#!/bin/bash
mode=fast
mode=slow
