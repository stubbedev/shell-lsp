### updates build on the old value
#!/bin/bash
# shellcheck enable=avoid-global-reassignment
total=0
list=
args=()
for n in 1 2 3; do
  total=$((total + n))
  (( total += n ))
  (( total++ ))
  list="$list $n"
  args+=("$n")
  args[0]=first
done
echo "$total $list ${args[*]}"
>>> none

### loop variables and builtin targets are filled by the shell
#!/bin/bash
# shellcheck enable=avoid-global-reassignment
for f in a b; do echo "$f"; done
for f in c d; do echo "$f"; done
read -r line
read -r line
echo "$line"
>>> none

### exclusive branches of if and case
#!/bin/bash
# shellcheck enable=avoid-global-reassignment
if [ -n "$1" ]; then
  out=$1
elif [ -n "$2" ]; then
  out=$2
else
  out=default
fi
case $3 in
  a) level=1 ;;
  b) level=2 ;;
esac
echo "$out $level"
>>> none

### a default overridden later is a new value
#!/bin/bash
# shellcheck enable=avoid-global-reassignment
out=default
if [ -n "$1" ]; then
  out=$1
fi
found=false
for f in *; do [ -e "$f" ] && found=true; done
echo "$out $found"
