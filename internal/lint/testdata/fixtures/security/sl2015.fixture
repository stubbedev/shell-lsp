### functions that change top-level globals
#!/bin/bash
# shellcheck enable=avoid-global-reassignment
count=0
names=()
bump() {
  count=$((count + 1))
  count=$((count + 1))
  names+=("$1")
}
scan() {
  for count in 1 2; do :; done
  declare -g count=9
}
quiet() {
  local count=5
  count=6
  echo "$count"
}
bump a
scan
quiet
echo "$count ${names[*]}"
