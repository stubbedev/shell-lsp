### getopt output is quoted for eval
#!/bin/bash
TEMP=$(getopt -o ab -- "$@")
eval set -- "$TEMP"
>>> none

### command output is not the caller's data
#!/bin/bash
eval -- "$("$1" --completions bash)"
eval "$(dircolors -b)"
>>> none

### literal case arms restrict the value
#!/bin/bash
case $1 in
  start|stop) eval "service_$1" ;;
esac
>>> none

### a regex guard validates the value
#!/bin/bash
if [[ ! $1 =~ ^[a-z]+$ ]]; then exit 1; fi
eval "run_$1"
>>> none

