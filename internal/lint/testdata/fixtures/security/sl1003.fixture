### arithmetic on an argument when enabled
#!/bin/bash
# shellcheck enable=arithmetic-injection
n=$1
if (( n > 3 )); then echo big; fi
echo $(( $1 + 1 ))
[[ $1 -eq 3 ]] && echo three
[ "$1" -eq 3 ] && echo three
>>> none
>>+ SL1003 4:7 -- shell-lsp native injection check; shellcheck has no taint analysis
>>+ SL1003 5:10 -- shell-lsp native injection check; shellcheck has no taint analysis
>>+ SL1003 6:4 -- shell-lsp native injection check; shellcheck has no taint analysis

### a guard validates the number
#!/bin/bash
# shellcheck enable=arithmetic-injection
[[ $1 =~ ^[0-9]+$ ]] || exit 1
echo $(( $1 + 1 ))
>>> none

### off unless enabled
#!/bin/bash
n=$1
if (( n > 3 )); then echo big; fi
>>> none

### zsh does not run code in arithmetic subscripts
#!/bin/zsh
# shellcheck enable=arithmetic-injection
n=$1
if (( n > 3 )); then print big; fi
print $(( $1 + 1 ))
>>- SC1071 1:1 -- shellcheck refuses zsh; zsh evaluates a[$(cmd)] in arithmetic without running the command

### ksh runs code in arithmetic subscripts too
#!/bin/ksh
# shellcheck enable=arithmetic-injection
n=$1
if (( n > 3 )); then print big; fi
>>> none
>>+ SL1003 4:7 -- shell-lsp native injection check; ksh93 evaluates array subscripts in arithmetic like bash

### printf with only numeric conversions prints a plain number
#!/bin/bash
# shellcheck enable=arithmetic-injection
printf -v code '%d' "'$1"
printf -v hex '%#06x' "$1"
printf -v text '%s' "$1"
(( code > 3 )) && echo big
(( hex > 3 )) && echo big
(( text > 3 )) && echo big
>>> none
>>+ SL1003 8:4 -- shell-lsp native injection check; %s copies the argument's text, while %d and %x print only a number
