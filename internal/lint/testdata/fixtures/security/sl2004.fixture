>>+ SL2004 3:29 -- shell-lsp native check; shellcheck does not flag a trap that only lives in a subshell

### saving, resetting and subshell-scoped traps are fine
#!/bin/bash
old=$(trap -p EXIT)
( trap 'rm -f y' EXIT; echo sub )
out=$(trap - EXIT; echo z)
f() { trap 'echo f' RETURN; }
f
echo "$old $out"
>>> none
