### a trap set inside a command substitution or pipeline stage
#!/bin/bash
tmp=$(trap 'rm -f x' EXIT; mktemp)
seq 3 | while read -r n; do trap 'echo bye' EXIT; done
echo "$tmp $n"
>>> SC2030 3:23
>>> SC2031 4:12
