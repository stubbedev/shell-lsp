### zsh rejects a bracketed element in a pair list
#!/bin/zsh
typeset -A n
n=(a 1 [b]=2)
print -r -- ${(kv)n}
>>- SC1071 1:1 -- shellcheck refuses zsh
>>+ SL2023 3:8 -- zsh rejects [key]=value in a key value list

### zsh rejects a bracketed element in the value position of a pair list
#!/bin/zsh
typeset -A n
n=(a [b]=2)
print -r -- ${(kv)n}
>>- SC1071 1:1 -- shellcheck refuses zsh
>>+ SL2023 3:6 -- zsh rejects [key]=value in a key value list

### an escaped bracket in a pair list is plain text
#!/bin/zsh
typeset -A n
n=(a 1 \[b]=2 3)
print -r -- ${(kv)n}
>>- SC1071 1:1 -- shellcheck refuses zsh

### an indexed array may mix bare and bracketed elements
#!/bin/bash
list=(a [3]=b)
echo "${list[@]}"
>>> none
