### bash reads a bracketed element of a pair list as a literal key
#!/bin/bash
declare -A n
n=(a 1 [b]=2)
echo "${n[@]}"
>>> SC2190 3:4
>>> SC2190 3:6
>>+ SL2023 3:8 -- shell-lsp native check; shellcheck does not know that bash 5.1 reads this list as key value pairs

