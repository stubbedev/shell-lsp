### looping over find in a dollar paren substitution
for f in $(find /var/log -type f); do
  echo "$f"
done
>>> SC2044 1:10

### find piped into sort is fine
for f in $(find . -type f | sort); do
  echo "$f"
done
>>> none

### extra text next to the substitution is fine
for f in prefix$(find . -type f); do
  echo "$f"
done
