### setopt extendedglob anywhere turns them on
#!/bin/zsh
setopt extended_glob
[[ $1 == (#i)yes ]] && print agreed
print -l ^*.o
>>- SC1071 1:1 -- shellcheck refuses zsh

### emulate -o extendedglob turns them on
#!/bin/zsh
f() {
  emulate -L zsh -o extendedglob
  print -l ^*.o
}
f
