### zsh matches a quoted regex as a regex
#!/bin/zsh
[[ $1 =~ '^([a-z]+)-([0-9]+)$' ]] && print -r -- $match[1] $match[2]
[[ $1 =~ "^v[0-9]+\.[0-9]+$" ]] && print -r -- $MATCH
