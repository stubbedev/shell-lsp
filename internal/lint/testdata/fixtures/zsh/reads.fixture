### the width of padding flags is arithmetic
#!/bin/zsh
up() {
  local -i n=${1:-1}
  cd ${(j:/:)${(s::)${(l:n::.:)}//./..}} || return
}
up "$@"
>>- SC1071 1:1 -- shellcheck refuses zsh; the l flag pads to n characters, so n is read

### an unset padding width is reported
#!/bin/zsh
print -r -- ${(r:width:)1}
