### zsh neither splits nor globs a parameter inside a loop glob
#!/bin/zsh
dir=$1
for f in $dir/*.zsh ${dir}/*.sh; do
  print -r -- $f
done
>>- SC1071 1:1 -- shellcheck refuses zsh; without GLOB_SUBST and SH_WORD_SPLIT the value of dir is used as it is

### zsh still splits a command substitution inside a loop glob
#!/bin/zsh
for f in $(pwd)/*.zsh; do
  print -r -- $f
done
>>- SC1071 1:1 -- shellcheck refuses zsh
>>+ SC2231 2:10 -- zsh splits unquoted command substitutions on IFS

### a tilde asks for the value to be globbed on purpose
#!/bin/zsh
dir=$1
for f in ${~dir}/*.zsh ${=dir}/*.sh; do
  print -r -- $f
done
>>- SC1071 1:1 -- shellcheck refuses zsh; ${~dir} and ${=dir} glob and split the value deliberately

### glob_subst makes zsh glob the value of a parameter
#!/bin/zsh
setopt glob_subst
dir=$1
for f in $dir/*.zsh; do
  print -r -- $f
done
>>- SC1071 1:1 -- shellcheck refuses zsh
>>+ SC2231 4:10 -- with GLOB_SUBST the value of dir is globbed

### sh_word_split makes zsh split the value of a parameter
#!/bin/zsh
unsetopt no_sh_word_split
dir=$1
for f in $dir/*.zsh; do
  print -r -- $f
done
>>- SC1071 1:1 -- shellcheck refuses zsh
>>+ SC2231 4:10 -- with SH_WORD_SPLIT the value of dir is split

### sh emulation globs and splits values
#!/bin/zsh
emulate -L sh
dir=$1
for f in $dir/*.zsh; do
  print -r -- $f
done
>>- SC1071 1:1 -- shellcheck refuses zsh
>>+ SC2231 4:10 -- emulating sh sets GLOB_SUBST and SH_WORD_SPLIT

