### zsh compares with the value of a parameter, not a pattern
#!/bin/zsh
a=$1 b=$2
[[ $a == $b ]] && print -r -- same
[[ $a == ${~b} ]] && print -r -- matches
>>- SC1071 1:1 -- shellcheck refuses zsh; without GLOB_SUBST $b is compared literally, and ${~b} is a pattern on purpose

### glob_subst makes the right side of == a pattern
#!/bin/zsh
setopt globsubst
a=$1 b=$2
[[ $a == $b ]] && print -r -- matches
>>- SC1071 1:1 -- shellcheck refuses zsh
>>+ SC2053 4:10 -- with GLOB_SUBST the value of b is a pattern

### bash matches the right side of == as a pattern
#!/bin/bash
a=$1 b=$2
[[ $a == "$b" ]] && echo same
[[ $a == $b ]] && echo matches
