### parameters the shell reads are not unused
#!/bin/zsh
PROMPT='%~ %# '
RPROMPT='%D{%H:%M}'
SAVEHIST=1000
WORDCHARS=${WORDCHARS//\/}
KEYTIMEOUT=1
fpath=(~/.zfunc $fpath)
cdpath=(~ ~/src)
psvar=(one)
typeset -ga precmd_functions
precmd_functions+=(_title)
reply=(a b)
>>- SC1071 1:1 -- shellcheck refuses zsh; zsh reads every one of these parameters itself

### line editor parameters in a widget
#!/bin/zsh
_accept() {
  BUFFER+=$POSTDISPLAY
  POSTDISPLAY=
  (( CURSOR = $#BUFFER ))
  region_highlight=()
  print -r -- $WIDGET $KEYS $LBUFFER $RBUFFER
}
zle -N accept _accept
>>- SC1071 1:1 -- shellcheck refuses zsh; zle sets and reads these parameters around every widget

### completion parameters in a completion function
#!/bin/zsh
_tool() {
  local curcontext=$curcontext state state_descr line ret=1
  typeset -A opt_args
  _arguments -C '1: :->cmd' && ret=0
  print -r -- $words[CURRENT] $opt_args[-v] $context
  return $ret
}
compdef _tool tool
>>- SC1071 1:1 -- shellcheck refuses zsh; _arguments sets these parameters and the completion system reads them

