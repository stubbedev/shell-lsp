### zsh assigns associative arrays from alternating keys and values
#!/bin/zsh
typeset -A table=(one 1 two 2)
typeset -A keys=(
  Home "${terminfo[khome]}"
  End "${terminfo[kend]}"
)
typeset -A opts
opts=(a 1 b 2)
typeset -A subscripted=([a]=1 [b]=2)
print -r -- $table[one] $keys[Home] $opts[a] $subscripted[b]
>>- SC1071 1:1 -- shellcheck refuses zsh; zsh takes alternating keys and values

### bash needs keys for associative array elements
#!/bin/bash
declare -A table=(one 1 two 2)
echo "${table[one]}"
