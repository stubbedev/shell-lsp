### sudo does not cover writing to proc
sudo echo 3 > /proc/sys/vm/drop_caches
>>> SC2024 1:13

### doas stdin redirection is not flagged by shellcheck 0.11
doas mysql inventory < /root/schema.sql
>>+ SC2024 1:22 -- doas has the same problem as sudo; shellcheck 0.11 only knows sudo (newer releases add doas and run0)

### run0 append redirection is not flagged by shellcheck 0.11
run0 echo "nameserver 1.1.1.1" >> /etc/resolv.conf
>>+ SC2024 1:32 -- run0 has the same problem as sudo; shellcheck 0.11 only knows sudo (newer releases add doas and run0)

### sudo does not cover the combined output redirection
sudo apt-get update &> /var/log/apt-refresh.log
>>+ SC2024 1:21 -- reported at the start of the &> operator
>>- SC2024 1:22 -- shellcheck points at the > inside &>; this linter reports the whole &> operator

### duplicating stderr onto stdout is fine
sudo make install 2>&1
>>> none

### explicit stderr descriptor to a log is fine
doas rc-service nginx reload 2> reload.log
>>> none

### discarding output to the null device is fine
run0 systemctl restart sshd > /dev/null 2>&1
>>> none

### sudo does not cover reading the input file
sudo mysql inventory < /root/schema.sql
>>> SC2024 1:22

### sudo does not cover appending to a protected file
sudo echo "nameserver 1.1.1.1" >> /etc/resolv.conf
>>> SC2024 1:32
