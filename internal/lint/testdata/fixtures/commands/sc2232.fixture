### sudo cannot change directory
sudo cd /root
>>> SC2232 1:1

### run0 export is not flagged by shellcheck 0.11
run0 export PATH=/opt/tools/bin
>>+ SC2232 1:1 -- run0 cannot run builtins either; shellcheck 0.11 only knows sudo (newer releases add doas and run0)

### sudo running ls
sudo ls /root
>>> none

### export after doas in a separate command
doas ls /root && export SEEN=1
>>> none

### sudo running echo with a builtin name as data
sudo echo ls
>>> none

### user named export consumed by -u
sudo -n -u export ls
>>> none

### docker export subcommand
sudo docker export web01
>>> none

### sudo cannot export
sudo export PATH=/opt/tools/bin
>>> SC2232 1:1

### sudo with a working directory still cannot change directory
sudo -D /srv cd app
>>+ SC2232 1:1 -- sudo -D takes a directory (sudo(8)); shellcheck 0.11 does not know -D and gives up on the options

### sudo -s runs the command through the target user's shell
sudo -s cd /root
>>> none

### sudo -i runs the command through a login shell
sudo -i export PATH=/opt/tools/bin
>>> none

### doas as another user cannot export
doas -u www export PATH=/opt/tools/bin
>>+ SC2232 1:1 -- doas runs programs, so export cannot run; shellcheck 0.11 only knows sudo (newer releases add doas and run0)

### doas -C only checks the configuration and runs nothing
doas -C /etc/doas.conf export PATH=/opt/tools/bin
>>> none
