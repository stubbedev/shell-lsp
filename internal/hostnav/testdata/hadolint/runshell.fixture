### dl3001-each-listed-command
FROM debian:12
RUN free -m
RUN echo
RUN kill -0 1
RUN echo
RUN mount
RUN echo
RUN ps aux
RUN echo
RUN service cron start
RUN echo
RUN shutdown -h now
RUN echo
RUN ssh example.org
RUN echo
RUN top -bn1
RUN echo
RUN vim -c q
>>> DL3001 10
>>> DL3001 12
>>> DL3001 14
>>> DL3001 16
>>> DL3001 18
>>> DL3001 2
>>> DL3001 4
>>> DL3001 6
>>> DL3001 8
