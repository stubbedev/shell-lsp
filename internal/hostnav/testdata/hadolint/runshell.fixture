### dl3001-unlisted-commands
FROM debian:12
RUN ifconfig && nano x && systemctl enable cron && htop && killall x && umount /x
>>> none
### dl3001-absolute-path-ignored
FROM debian:12
RUN /usr/bin/vim -c q
>>+ DL3001 2 -- /usr/bin/vim is vim, called by its path
