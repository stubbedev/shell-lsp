LABEL test.hash=0123abc
LABEL test.hash=0123abcd
LABEL test.hash=0123456789abcdef0123456789abcdef0123456
LABEL test.hash=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
>>- DL3055 5 -- git abbreviates hashes to 7 or more characters, and SHA-256 repositories use 64
>>- DL3055 6 -- git abbreviates hashes to 7 or more characters, and SHA-256 repositories use 64
>>- DL3055 7 -- git abbreviates hashes to 7 or more characters, and SHA-256 repositories use 64
