LABEL test.text=hello test.url=https://example.com test.email=dev@example.com test.time=2024-01-02T03:04:05Z test.spdx=MIT test.hash=abcdef0 test.semver=1.0.0
LABEL test.time=2024-01-02T03:04:05+0100
LABEL test.time=2024-01-02T03:04:05+01
LABEL test.time=2024-01-02T03:04:05+1:00
LABEL test.time=2024-01-02T03:04:05+99:99
LABEL test.time=2024-01-02T03:04:05UTC
>>+ DL3053 3 -- RFC 3339 writes offsets as +hh:mm with hours below 24 and minutes below 60
>>> DL3053 4
>>> DL3053 5
>>+ DL3053 6 -- RFC 3339 writes offsets as +hh:mm with hours below 24 and minutes below 60
>>> DL3053 7
